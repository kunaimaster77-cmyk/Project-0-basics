#*Temperature Function*


def temp_grid():
  
  temp = input.temperature()
  
  basic.clear_screen()
  
  if temp == 50:
    led.plot(0, 1)
    led.plot(0, 0)

  if temp > 45:
    led.plot(0, 3)
    led.plot(0, 2)

  if temp > 40:
    led.plot(1, 0)
    led.plot(0, 4)

  if temp > 35:
    led.plot(1, 2)
    led.plot(1, 1)

  if temp > 30:
    led.plot(1, 4)
    led.plot(1, 3)

  if temp > 25:
    led.plot(2, 1)
    led.plot(2, 0)

  if temp > 20:
    led.plot(2, 3)
    led.plot(2, 2)

  if temp > 15:
    led.plot(3, 0)
    led.plot(2, 4)

  if temp > 10:
    led.plot(3, 2)
    led.plot(3, 1)

  if temp > 5:
    led.plot(3, 4)
    led.plot(3, 3)

  if temp > 0:
    led.plot(4, 1)
    led.plot(4, 0)

  if temp >= -5:
    led.plot(4, 4)
    led.plot(4, 3)
    led.plot(4, 2)
    

def temp_symbol():
  basic.clear_screen()
  basic.show_string(temperature_symbol)
  pause(500)
  basic.clear_screen()
  pause(500) 

  

def get_temperature_colour():
  temp = input.temperature()

  if temp >= 50:
    return g_50t, b_50t, r_50t

  elif temp >= 45:
    return g_45t, b_45t, r_45t

  elif temp >= 40:
    return g_40t, b_40t, r_40t

  elif temp >= 35:
    return g_35t, b_35t, r_35t

  elif temp >= 30:
    return g_30t, b_30t, r_30t

  elif temp >= 25:
    return g_25t, b_25t, r_25t

  elif temp >= 20:
    return g_20t, b_20t, r_20t

  elif temp >= 15:
    return g_15t, b_15t, r_15t

  elif temp >= 10:
    return g_10t, b_10t, r_10t

  elif temp >= 5:
    return g_5t, b_5t, r_5t

  elif temp >= 0:
    return g_0t, b_0t, r_0t

  else:
    return g_neg5t, b_neg5t, r_neg5t

  
  
def temp_led(green, blue, red):
  pins.analog_write_pin(AnalogPin.P0, green)
  pins.analog_write_pin(AnalogPin.P1, blue)
  pins.analog_write_pin(AnalogPin.P2, red)


  
def show_temperature(): 
  temp_grid()
  green, blue, red = get_temperature_colour()
  temp_led(green, blue, red)
  


# Temperature mode
temperature_mode = False

def activate_temperature_mode():
  temp_symbol()
  pause(200)
  global temperature_mode
  temperature_mode = True
    

input.on_button_pressed(Button.B, activate_temperature_mode)

# Main loop
while True:
    if temperature_mode:
        show_temperature()

    pause(200)

